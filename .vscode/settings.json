{
  // 配置 CMake Tools 扩展
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": true,
  "clangd.path": "/home/codespace/.vscode-remote/data/User/globalStorage/llvm-vs-code-extensions.vscode-clangd/install/22.1.6/clangd_22.1.6/bin/clangd",
  // 告诉 clangd 编译数据库在构建目录中
  "clangd.arguments": [
    "-compile-commands-dir=${workspaceFolder}/build"
  ],
  // format
  "editor.tabSize": 4,
  "cSpell.enabled": false,
  "files.autoSave": "afterDelay",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "xaver.clang-format",
}